{
  "name": "edulink-gh-web",
  "version": "1.0.0",
  "private": true,
  "description": "EduLink GH - cloud school management and terminal report system for schools across Ghana.",
  "author": "Emmanuel Serry",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
