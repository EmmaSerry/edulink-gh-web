# Copy this file to .env.local and fill in your own Supabase project's
# values (Project Settings -> API Keys -> Publishable/anon key).
# .env.local is gitignored - never commit real keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Paystack (Project Settings -> API Keys & Webhooks in your Paystack
# dashboard). Only the PUBLIC key goes here - it's safe to expose in
# browser code. The secret key is a Supabase Edge Function secret
# instead (PAYSTACK_SECRET_KEY), never in this app's own env vars.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
